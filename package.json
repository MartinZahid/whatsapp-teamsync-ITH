{
  "name": "whatsapp-teamsync-ith",
  "version": "0.1.0",
  "description": "Servidor WebSocket de presencia en tiempo real para equipos de atención al cliente en WhatsApp Web",
  "type": "module",
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "server": "node server/dist/server/src/server.js",
    "dev:server": "tsc -p server/tsconfig.json --watch"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}
