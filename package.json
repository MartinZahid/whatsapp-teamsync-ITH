{
  "name": "whatsapp-teamsync-ith",
  "version": "0.1.0",
  "description": "Servidor WebSocket de presencia en tiempo real para equipos de atención al cliente en WhatsApp Web",
  "type": "module",
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json && node -e \"require('fs').copyFileSync('server/src/datos/esquema.sql','server/dist/server/src/datos/esquema.sql')\"",
    "server": "node server/dist/server/src/server.js",
    "dev:server": "tsc -p server/tsconfig.json --watch",
    "build:extension": "vite build -c extension/vite.config.ts && vite build -c extension/vite.content.config.ts",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "dev:extension": "vite build -c extension/vite.config.ts --watch",
    "test": "npm run build:server && node --test \"server/dist/**/*.test.js\""
  },
  "dependencies": {
    "sql.js": "^1.16.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.10.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0",
    "vite": "^8.3.7"
  }
}
